{
  "name": "apaleo-datev-export",
  "version": "0.1.0",
  "description": "Free open-source export from the apaleo hotel PMS to DATEV-Format (EXTF) Buchungsstapel files.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.1",
  "bin": {
    "apaleo-datev": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "DISCLAIMER.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "iconv-lite": "^0.7.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
